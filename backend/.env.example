# --- LLM (Anthropic) ---------------------------------------------------------
# The only credential the app needs. It powers both content generation and
# web search, because web search runs server-side as an Anthropic tool.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Set to 1 to run the whole pipeline against a deterministic fake LLM.
# The dashboard, schema validation, retrieval and dedup all work offline.
# Leave unset (or 0) once ANTHROPIC_API_KEY is populated.
MOCK_LLM=0

# --- Retrieval ---------------------------------------------------------------
CHROMA_PERSIST_DIR=../chroma_db
CHROMA_COLLECTION=sports_knowledge

# "default" uses ChromaDB's bundled ONNX all-MiniLM-L6-v2 (no PyTorch).
# "sentence-transformers" requires the optional dependency.
EMBEDDING_BACKEND=default

# Turn web search off to generate purely from ChromaDB (faster, cheaper).
ENABLE_WEB_SEARCH=1
WEB_SEARCH_MAX_USES=6

# --- Freshness ---------------------------------------------------------------
# Cross-session ledger of everything already generated, used to avoid repeats.
HISTORY_PATH=../data/generated_history/ledger.jsonl
NOVELTY_LOOKBACK=400

# --- Server ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
